{
  "name": "vision-pdv-desktop",
  "productName": "Vision PDV",
  "version": "1.1.0",
  "description": "Vision PDV para Windows",
  "author": "Vision PDV",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.visionpdv.app",
    "productName": "Vision PDV",
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vision PDV",
      "artifactName": "Instalador-Vision-PDV.exe"
    }
  },
  "devDependencies": {
    "electron": "32.1.2",
    "electron-builder": "25.0.5"
  }
}
